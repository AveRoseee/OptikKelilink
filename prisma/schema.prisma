generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Gender {
  MEN
  WOMEN
  UNISEX
  KIDS
}

enum MarketplacePlatform {
  SHOPEE
  TIKTOK_SHOP
  TOKOPEDIA
}

model Product {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  brand        String
  description  String        @db.Text
  gender       Gender        @default(UNISEX)
  basePrice    Decimal       @db.Decimal(12, 2)
  mainImageUrl String?
  thumbnailUrl String?
  isFeatured   Boolean       @default(false)
  status       ProductStatus @default(DRAFT)
  categoryId   String
  collectionId String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  category         Category             @relation(fields: [categoryId], references: [id])
  collection       Collection?          @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  variants         ProductVariant[]
  marketplaceLinks MarketplaceLink[]
  specification    Specification?
  translations     ProductTranslation[]
  analyticsEvents  AnalyticsEvent[]

  @@index([status, isFeatured])
  @@index([categoryId, status])
  @@index([collectionId, status])
}

model ProductVariant {
  id                String   @id @default(cuid())
  productId         String
  colorName         String
  colorHex          String
  frameMaterial     String
  lensType          String
  sizeCode          String
  model3dUrl        String?
  model3dPoster     String?
  materialOverrides Json?
  isAvailable       Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  gallery          ProductMedia[]
  marketplaceLinks MarketplaceLink[]
  analyticsEvents  AnalyticsEvent[]

  @@unique([productId, colorName, lensType, sizeCode])
  @@index([productId, isAvailable])
}

model ProductMedia {
  id        String @id @default(cuid())
  variantId String
  url       String
  alt       String
  sortOrder Int    @default(0)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, sortOrder])
}

model MarketplaceLink {
  id           String              @id @default(cuid())
  productId    String
  variantId    String?
  platform     MarketplacePlatform
  url          String
  affiliateUrl String?
  isActive     Boolean             @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId, platform, isActive])
  @@index([variantId, platform, isActive])
}

model Specification {
  id             String  @id @default(cuid())
  productId      String  @unique
  frameWidthMm   Int?
  lensWidthMm    Int?
  bridgeWidthMm  Int?
  templeLengthMm Int?
  weightGrams    Int?
  warranty       String?
  includedItems  Json?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Category {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  imageUrl String?
  parentId String?

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([parentId])
}

model Collection {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String? @db.Text
  coverImage  String?

  products Product[]
}

model ProductTranslation {
  id          String @id @default(cuid())
  productId   String
  locale      String
  name        String
  description String @db.Text

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@index([locale])
}

model AnalyticsEvent {
  id        String               @id @default(cuid())
  eventName String
  productId String?
  variantId String?
  platform  MarketplacePlatform?
  sessionId String?
  source    String?
  campaign  String?
  metadata  Json?
  createdAt DateTime             @default(now())

  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([eventName, createdAt])
  @@index([productId, createdAt])
  @@index([platform, createdAt])
}
