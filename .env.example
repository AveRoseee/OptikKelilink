# Supabase PostgreSQL. Copy both connection strings from Supabase Dashboard > Connect.
# DATABASE_URL: use the Session pooler (port 5432) for local development.
# DIRECT_URL: use the Direct connection for Prisma migrations (IPv6 or IPv4 add-on required).
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<DATABASE_PASSWORD>@<POOLER_HOST>:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:<DATABASE_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require"

# Optional Supabase Storage settings for product photos and GLB files.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Email address allowed to use the admin dashboard. ADMIN_EMAILS also accepts comma-separated lists.
ADMIN_EMAIL="admin@example.com"
